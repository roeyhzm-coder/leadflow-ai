# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend (Vercel Serverless)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
WHATSAPP_API_TOKEN=your-green-api-token
WHATSAPP_API_URL=https://7107.api.greenapi.com
WHATSAPP_INSTANCE_ID=710722751571
# Comma-separated numbers the bot may answer (e.g. 972504572767,0501234567); empty or * answers everyone.
ALLOWED_TEST_NUMBERS=

# Optional
# Per-tenant Green API tokens keyed by instance id; falls back to WHATSAPP_API_TOKEN.
# GREEN_API_TOKENS={"710722751571":"token-a","7107000000":"token-b"}
# GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=https://your-project.supabase.co
# Comma-separated origins allowed to call /api cross-origin (the same-origin dashboard needs none).
ALLOWED_ORIGINS=
# Green API webhookUrlToken; when set, /api/webhook rejects calls without it (401).
GREEN_API_WEBHOOK_TOKEN=
